# Copiar a .env (que NO se sube al repo) y completar.
# Generar una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-por-una-clave-nueva
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL y Redis levantados con docker compose
DATABASE_URL=postgres://drivly:drivly@localhost:5432/drivly
REDIS_URL=redis://localhost:6379/0

# Email: vacío = consola en desarrollo
EMAIL_HOST=
EMAIL_USE_TLS=True
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=Drivly <no-reply@drivly.local>

# Reglas de negocio
HOLD_TTL_MIN=5
RADIO_CERCANOS_M=1000
# Reembolso total al cancelar una reserva pagada hasta estos minutos antes del inicio
CANCELACION_ANTICIPACION_MIN=120
# ...o dentro de estos minutos desde el pago (para quien reserva sobre la hora)
CANCELACION_GRACIA_MIN=10

# Integraciones (credenciales de prueba / sandbox)
GOOGLE_OAUTH_CLIENT_IDS=
# Split de pagos: cada garaje conecta su cuenta y cobra ahí; Drivly retiene COMISION_DRIVLY por pago.
# Los comentarios van siempre en su propia línea, nunca después del valor.
# MP_APP_ID: DevPanel → app Drivly → "N.º de la aplicación" / Client ID (sólo números)
MP_APP_ID=
# MP_CLIENT_SECRET: DevPanel → app Drivly → Credenciales de producción → Client Secret
MP_CLIENT_SECRET=
# MP_OAUTH_REDIRECT_URI: idéntica, carácter por carácter, a la Redirect URL configurada en el panel
MP_OAUTH_REDIRECT_URI=http://localhost:8000/api/pagos/oauth/callback/
# MP_TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_ENCRYPTION_KEY=
COMISION_DRIVLY=0.10
# MERCADOPAGO_WEBHOOK_SECRET: DevPanel → Webhooks → Clave secreta. Sin ella el webhook rechaza todo (401)
MERCADOPAGO_WEBHOOK_SECRET=

# Mercado Pago — back_urls y notification_url
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Para probar Mercado Pago en desarrollo: `ngrok http --url=<dominio> 5173` (Vite reenvía /api a Django)
# y usar el mismo dominio en FRONTEND_URL y BACKEND_URL. Con HTTPS público MP vuelve solo a la app (auto_return).
# En frontend/.env: VITE_API_URL=/api
PAGOS_SIMULADOS=False
PATENTE_AR_API_KEY=
PATENTE_AR_MOCK=True
