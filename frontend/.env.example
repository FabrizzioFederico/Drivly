# URL base de la API Django REST Framework
VITE_API_URL=http://localhost:8000/api
# Client ID de Google OAuth (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=
# true = usa datos simulados en memoria (sin backend)
VITE_USE_MOCKS=true
# Garaje por defecto para Playero / Admin cuando el usuario no trae uno asignado
VITE_DEFAULT_GARAJE_ID=1
