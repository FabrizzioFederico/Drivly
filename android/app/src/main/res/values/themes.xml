<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Drivly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo_ventana</item>
    </style>

    <!-- Pantalla de inicio (core-splashscreen): la "P" de Drivly sobre círculo azul; después pasa a Theme.Drivly -->
    <style name="Theme.Drivly.Inicio" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/fondo_ventana</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/marca</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Drivly</item>
    </style>
</resources>
