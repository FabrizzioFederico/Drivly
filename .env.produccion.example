# Variables de entorno de la API en Render (Web Service > Environment).
# Este archivo es sólo una guía: los valores reales se cargan en Render, nunca en el repo.
# Reemplazá drivly-api.onrender.com y drivly.onrender.com por las direcciones reales de tus servicios.
# Los comentarios van siempre en su propia línea, nunca después del valor.

# --- Django -------------------------------------------------------------------
# La misma versión de Python que en desarrollo
PYTHON_VERSION=3.13.2
# Una clave NUEVA (no la del .env local): python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=drivly-api.onrender.com
# Para entrar al admin de Django (https://drivly-api.onrender.com/admin/)
CSRF_TRUSTED_ORIGINS=https://drivly-api.onrender.com
# La web (landing y panel)
CORS_ALLOWED_ORIGINS=https://drivly.onrender.com
FRONTEND_URL=https://drivly.onrender.com
BACKEND_URL=https://drivly-api.onrender.com

# --- Base de datos ---------------------------------------------------------------
# Render > tu PostgreSQL > Connections > Internal Database URL
DATABASE_URL=

# --- Redis / Celery ---------------------------------------------------------------
# SÓLO si hay un Background Worker corriendo Celery. Con Redis y sin worker, los avisos quedan encolados y no salen;
# sin REDIS_URL se mandan en el momento. Render > tu Key Value > Internal URL
# REDIS_URL=

# --- Fotos (Cloudinary) -----------------------------------------------------------
# Cloudinary > Dashboard > "API environment variable": cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Google (login) ---------------------------------------------------------------
# Google Cloud Console > Credenciales > el client ID WEB (el mismo que VITE_GOOGLE_CLIENT_ID)
GOOGLE_OAUTH_CLIENT_IDS=

# --- Mercado Pago -----------------------------------------------------------------
# DevPanel > tu aplicación > N.º de aplicación (sólo números)
MP_APP_ID=
# DevPanel > tu aplicación > Credenciales de producción > Client Secret
MP_CLIENT_SECRET=
# Idéntica a la Redirect URL configurada en la aplicación de Mercado Pago
MP_OAUTH_REDIRECT_URI=https://drivly-api.onrender.com/api/pagos/oauth/callback/
# NUEVA: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guardala: si cambia, los garajes tienen que volver a conectar Mercado Pago.
MP_TOKEN_ENCRYPTION_KEY=
# DevPanel > Webhooks (URL https://drivly-api.onrender.com/api/pagos/webhook/, evento Pagos) > Clave secreta
MERCADOPAGO_WEBHOOK_SECRET=
PAGOS_SIMULADOS=False
COMISION_DRIVLY=0.10
APP_DEEPLINK_PAGO=drivly://pago-resultado

# --- DataCar (categoría del vehículo) ---------------------------------------------
# Cada patente consultada gasta un crédito
DATACAR_API_URL=
DATACAR_API_KEY=
DATACAR_MOCK=False

# --- Notificaciones push (Firebase) -----------------------------------------------
FCM_PROJECT_ID=
# Subí firebase-cuenta-servicio.json en Render > Environment > Secret Files: queda en /etc/secrets/
FCM_CREDENCIALES=/etc/secrets/firebase-cuenta-servicio.json

# --- Email -------------------------------------------------------------------------
# El plan gratis de Render bloquea el SMTP saliente (también el 2525): se manda por la API web de Brevo (HTTPS).
# Brevo > SMTP & API > pestaña "API Keys" > Generate a new API key. Con BREVO_API_KEY no se usan las EMAIL_*.
BREVO_API_KEY=
# Tiene que ser un remitente verificado en Brevo (Senders, Domains & Dedicated IPs > Senders)
DEFAULT_FROM_EMAIL=Drivly <tu-email-verificado@ejemplo.com>
# Recibe los formularios "Sumá tu garaje" de la landing
CONTACTO_EMAIL=

# --- Reglas de negocio (opcionales: estos son los valores por defecto) ------------
HOLD_TTL_MIN=5
RADIO_CERCANOS_M=1000
CANCELACION_ANTICIPACION_MIN=120
CANCELACION_GRACIA_MIN=10
DEUDA_BLOQUEO_HORAS=72
DEUDA_INCOBRABLE_DIAS=30
